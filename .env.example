# Optional local AI diagnosis (blank uses the human-review fallback).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Optional Telegram incident notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local dashboard login. Use a strong password on any server.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-deploy

# Local port overrides.
APP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Optional Grafana Cloud metrics forwarding. Configure only when using the
# `grafana-cloud` Compose profile; keep the access token in .secrets/ instead.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=

# Healer safety limits.
HEALER_MAX_CALLS_PER_MIN=1
HEALER_MAX_RESTARTS_PER_HOUR=3
HEALER_LOG_LINES=50

# Optional dashboard restart action token (set a long random value for local Compose).
DASHBOARD_ACTION_TOKEN=
